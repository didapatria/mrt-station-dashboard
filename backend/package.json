{
  "name": "mrt-station-dashboard-backend",
  "version": "2.18.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npx prisma generate --schema=src/prisma/schema.prisma && tsc && cp -r src/prisma dist/",
    "start": "npx prisma migrate deploy --schema=dist/prisma/schema.prisma && node dist/index.js",
    "seed": "tsx src/prisma/seed.ts",
    "db:migrate": "npx prisma migrate dev",
    "db:fresh": "npx prisma migrate reset --force",
    "db:fresh:seed": "npx prisma migrate reset --force && npm run seed",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [
    "mrt",
    "station",
    "dashboard",
    "express",
    "prisma"
  ],
  "author": "Dida",
  "license": "MIT",
  "description": "Backend API for MRT Station Management Dashboard",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
