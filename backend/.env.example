# Local development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mrt_station_db?schema=public"

# Supabase (production) — get from: Project Settings > Database > Connection string
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"
PORT=3000
NODE_ENV=development

# Local: http://localhost:5173
# Production (Vercel): https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
